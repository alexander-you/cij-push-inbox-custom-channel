<?xml version="1.0" encoding="utf-8"?>
<Role id="{b2464e9a-0fe8-f111-84e7-7ced8d726840}" name="Push Inbox Log Writer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <IsCustomizable>1</IsCustomizable>
  <IsAutoAssigned>0</IsAutoAssigned>
  <Description>Least-privilege role for the Azure backend application user: creates and updates its own Push message log rows and links them to contacts.</Description>
  <RolePrivileges>
    <RolePrivilege name="prvAppendalex_PushMessageLog" level="Basic" />
    <RolePrivilege name="prvAppendToContact" level="Global" />
    <RolePrivilege name="prvCreatealex_PushMessageLog" level="Basic" />
    <RolePrivilege name="prvCreateSharePointData" level="Global" />
    <RolePrivilege name="prvReadalex_PushMessageLog" level="Basic" />
    <RolePrivilege name="prvReadPluginAssembly" level="Global" />
    <RolePrivilege name="prvReadPluginType" level="Global" />
    <RolePrivilege name="prvReadSdkMessage" level="Global" />
    <RolePrivilege name="prvReadSdkMessageProcessingStep" level="Global" />
    <RolePrivilege name="prvReadSdkMessageProcessingStepImage" level="Global" />
    <RolePrivilege name="prvReadSharePointData" level="Global" />
    <RolePrivilege name="prvReadSharePointDocument" level="Global" />
    <RolePrivilege name="prvWritealex_PushMessageLog" level="Basic" />
    <RolePrivilege name="prvWriteSharePointData" level="Global" />
  </RolePrivileges>
</Role>